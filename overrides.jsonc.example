{
  "$schema": "./overrides.schema.json",

  // Extension-owned child runtime policy.
  // Missing model/thinking means: inherit the active parent Pi session values.
  // Do not put Pi defaultModel/defaultThinkingLevel here; use Pi settings for those.
  "defaults": {
    "tools": ["read", "grep", "find", "ls"],
    "defaultContext": "fresh",
    "maxSubagentDepth": 1
  },

  "agentOverrides": {
    "google-analyst": {
      "tools": ["read", "bash", "grep", "find", "ls"],
      "defaultContext": "fork"
    },

    "gtm-admin": {
      "tools": ["read", "bash", "write", "edit", "grep", "find", "ls"],
      "timeoutMs": 1800000,
      "defaultContext": "fork"
    },

    "maribel": {
      // Maribel's markdown may come from Claude and include Claude-only tools.
      // This Pi runtime allowlist replaces those values for child runs.
      "tools": ["read", "grep", "find", "ls"],
      "defaultContext": "fork"
    },

    "researcher": {
      // Example of an intentional per-agent pin. Remove model/thinking to inherit parent Pi.
      "model": "openai-codex/gpt-5.4",
      "thinking": "medium",
      "tools": ["read", "write", "grep", "find", "ls"],
      "defaultContext": "fresh",
      "timeoutMs": 1800000
    }
  }
}
