  },
  "homepage": "https://github.com/damupi/pi-subagents-compatible#readme",
  "bugs": {
    "url": "https://github.com/damupi/pi-subagents-compatible/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "subagents",
    "claude-compatible",
    "typescript",
    "ai-agent",
    "developer-tools"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "overrides.schema.json",
    "overrides.jsonc.example"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
