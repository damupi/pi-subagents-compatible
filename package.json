{
  "name": "pi-subagents-compatible",
  "version": "0.1.0",
  "description": "Claude-compatible subagent workflow for Pi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
